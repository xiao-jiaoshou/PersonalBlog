<UserControl x:Class="PersonalBlog.Views.CrcCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PersonalBlog.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:CrcCalculatorViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="CRC 计算器"
                       Style="{StaticResource TitleStyle}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xE70B;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="36"
                               Foreground="{StaticResource GoldPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="通用 CRC 校验计算"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               FontFamily="Microsoft YaHei"/>
                    <TextBlock Text="支持常见参数模型与自定义参数，可输入文本或十六进制数据进行计算。"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="输入数据"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="180"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource BackgroundHover}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderDark}"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontFamily="Consolas"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox Content="十六进制输入"
                                      IsChecked="{Binding IsHexInput, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <Button Content="计算"
                                    Command="{Binding CalculateCommand}"
                                    Style="{StaticResource LinkButton}"
                                    Margin="20,0,0,0"/>
                            <Button Content="清空"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource LinkButton}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="参数模型"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Background="{DynamicResource BackgroundDark}"
                                  Foreground="{StaticResource TextGold}"
                                  BorderBrush="{StaticResource BorderGold}"/>

                        <TextBlock Text="宽度"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,15,0,5"/>
                        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundHover}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderDark}"
                                 Padding="8"/>

                        <TextBlock Text="多项式"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding Polynomial, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundHover}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderDark}"
                                 Padding="8"
                                 FontFamily="Consolas"/>

                        <TextBlock Text="初始值"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding InitialValue, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundHover}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderDark}"
                                 Padding="8"
                                 FontFamily="Consolas"/>

                        <StackPanel Margin="0,12,0,0">
                            <CheckBox Content="输入反转"
                                      IsChecked="{Binding ReflectInput, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <CheckBox Content="输出反转"
                                      IsChecked="{Binding ReflectOutput, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{StaticResource TextSecondary}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Text="输出异或"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding XorOut, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundHover}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderDark}"
                                 Padding="8"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="计算结果"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimary}"/>

                    <TextBlock Text="十六进制"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,12,0,5"/>
                    <TextBox Text="{Binding ResultHex, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="{StaticResource BackgroundHover}"
                             Foreground="{StaticResource GoldPrimary}"
                             BorderBrush="{StaticResource BorderDark}"
                             Padding="8"
                             FontFamily="Consolas"/>

                    <TextBlock Text="十进制"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,12,0,5"/>
                    <TextBox Text="{Binding ResultDec, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="{StaticResource BackgroundHover}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderDark}"
                             Padding="8"
                             FontFamily="Consolas"/>

                    <TextBlock Text="二进制"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,12,0,5"/>
                    <TextBox Text="{Binding ResultBin, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"
                             Background="{StaticResource BackgroundHover}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderDark}"
                             Padding="8"
                             FontFamily="Consolas"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="复制十六进制结果"
                                Command="{Binding CopyResultCommand}"
                                Style="{StaticResource LinkButton}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
